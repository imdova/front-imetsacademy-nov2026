# IMETS Academy web — PRODUCTION environment
# On the server: copy to `.env.production` in the repo root (gitignored), then rebuild.
#   cp deploy/env.production.example .env.production
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined at BUILD time, so you must
# `pnpm build` again after changing them.

# Public site origin (used for absolute URLs, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://test.imetsacademy.com

# Base URL of the backend API (note the /api/v1 prefix).
NEXT_PUBLIC_API_BASE_URL=https://api.imetsacademy.com/api/v1

# Data source for the server-side DAL:
#   mock = built-in demo data (no backend needed)
#   api  = read/write the live NestJS backend (auth, categories, courses)
# Set this to `api` to use the real database.
DATA_SOURCE=api
